{% extends 'base.html.twig' %}

{% block title %}Tableau de bord - DivaTime{% endblock %}

{% block body %}
<!-- Section accueil -->
<div class="mb-5">
    <div class="d-flex align-items-center gap-3 mb-2">
        <h2 class="fw-bold mb-0">Bonjour, {{ userName }}!</h2>
        {% if isAdmin %}
            <span class="badge bg-warning text-dark border-0 rounded-pill px-3 py-2 small fw-bold shadow-sm">
                <i class="fa-solid fa-shield-halved me-1"></i> VUE ADMIN
            </span>
        {% endif %}
    </div>
    <p class="text-muted">Voici votre aperçu professionnel pour aujourd'hui.</p>
</div>

<!-- Zone stats -->
{{ include('dashboard/_content.html.twig') }}

<style>
    .letter-spacing-1 { letter-spacing: 0.5px; }
    .avatar-sm { line-height: 1; }
    .table-hover tbody tr:hover {
        background-color: rgba(99, 102, 241, 0.03);
        cursor: default;
    }
</style>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
(function() {
    const chartDaysLabels  = {{ chartDaysLabels|raw }};
    const chartDaysData    = {{ chartDaysData|raw }};
    const chartProjectLabels = {{ chartProjectLabels|raw }};
    const chartProjectData   = {{ chartProjectData|raw }};
    const chartProjectColors = {{ chartProjectColors|raw }};

    function renderCharts() {
        if (typeof Chart === 'undefined') return;

        // Détruire anciens graphiques
        ['hoursBarChart', 'projectDoughnutChart'].forEach(id => {
            const existing = Chart.getChart(id);
            if (existing) existing.destroy();
        });

        // ─── Bar chart: Heures par jour ─────────────────────────────────────
        const barCtx = document.getElementById('hoursBarChart');
        if (barCtx) {
            new Chart(barCtx, {
                type: 'bar',
                data: {
                    labels: chartDaysLabels,
                    datasets: [{
                        label: 'Heures',
                        data: chartDaysData,
                        backgroundColor: 'rgba(99,102,241,0.2)',
                        borderColor: 'rgba(99,102,241,1)',
                        borderWidth: 2,
                        borderRadius: 8,
                        borderSkipped: false,
                        hoverBackgroundColor: 'rgba(168,85,247,0.35)',
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: { callbacks: { label: ctx => ` ${ctx.parsed.y} h` } }
                    },
                    scales: {
                        x: { grid: { display: false }, ticks: { font: { size: 11 }, color: '#64748b' } },
                        y: { beginAtZero: true, grid: { color: 'rgba(0,0,0,0.04)' }, ticks: { font: { size: 11 }, color: '#64748b' } }
                    }
                }
            });
        }

        // ─── Doughnut chart: Heures par projet ──────────────────────────────
        const doughnutCtx = document.getElementById('projectDoughnutChart');
        if (doughnutCtx && chartProjectData.length > 0) {
            new Chart(doughnutCtx, {
                type: 'doughnut',
                data: {
                    labels: chartProjectLabels,
                    datasets: [{
                        data: chartProjectData,
                        backgroundColor: chartProjectColors.map(c => c + '99'),
                        borderColor: chartProjectColors,
                        borderWidth: 2,
                        hoverOffset: 8,
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '65%',
                    plugins: {
                        legend: { position: 'right', labels: { font: { size: 11 }, color: '#334155', padding: 12, boxWidth: 12 } },
                        tooltip: { callbacks: { label: ctx => ` ${ctx.label}: ${ctx.parsed} h` } }
                    }
                }
            });
        } else if (doughnutCtx) {
            doughnutCtx.parentElement.innerHTML = '<div class="text-center text-muted py-5"><i class="fa-solid fa-chart-pie opacity-25 fa-3x mb-3 d-block"></i>Aucune donnée</div>';
        }
    }

    // Exécuter au chargement initial ET à chaque navigation Turbo
    document.addEventListener('DOMContentLoaded', renderCharts);
    document.addEventListener('turbo:load', renderCharts);
})();
</script>
{% endblock %}
