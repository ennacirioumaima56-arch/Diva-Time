{% extends 'base.html.twig' %}

{% block title %}Dashboard - DivaTime{% endblock %}

{% block body %}
<!-- Welcome Section -->
<div class="mb-5">
    <div class="d-flex align-items-center gap-3 mb-2">
        <h2 class="fw-bold mb-0">Hello, {{ userName }}!</h2>
        {% if isAdmin %}
            <span class="badge bg-warning text-dark border-0 rounded-pill px-3 py-2 small fw-bold shadow-sm">
                <i class="fa-solid fa-shield-halved me-1"></i> ADMIN VIEW
            </span>
        {% endif %}
    </div>
    <p class="text-muted">Here is your professional overview for today.</p>
</div>

<!-- Stats Overview -->
<div class="row g-4 mb-5">
    <div class="col-12 col-md-4">
        <div class="glass-card h-100 border-0 shadow-sm position-relative overflow-hidden">
            <div class="position-absolute opacity-10" style="right: -10px; bottom: -10px; font-size: 5rem;">
                <i class="fa-solid fa-clock"></i>
            </div>
            <div class="small text-muted mb-1 text-uppercase fw-bold letter-spacing-1">
                {% if isAdmin %}Total Team Hours{% else %}Your Total Hours{% endif %}
            </div>
            <div class="d-flex align-items-center gap-3 mt-2">
                <div class="h1 fw-bold mb-0 text-primary">{{ totalHours }}</div>
                <div class="badge bg-primary-subtle text-primary rounded-pill px-3">Hrs</div>
            </div>
        </div>
    </div>
    
    <div class="col-12 col-md-4">
        <div class="glass-card h-100 border-0 shadow-sm position-relative overflow-hidden">
            <div class="position-absolute opacity-10" style="right: -10px; bottom: -10px; font-size: 5rem;">
                <i class="fa-solid fa-diagram-project"></i>
            </div>
            <div class="small text-muted mb-1 text-uppercase fw-bold letter-spacing-1">Active Projects</div>
            <div class="d-flex align-items-center gap-3 mt-2">
                <div class="h1 fw-bold mb-0 text-info">{{ activeProjectsCount }}</div>
                <div class="badge bg-info-subtle text-info rounded-pill px-3">Live</div>
            </div>
        </div>
    </div>
    
    <div class="col-12 col-md-4">
        <div class="glass-card h-100 border-0 shadow-sm position-relative overflow-hidden">
            <div class="position-absolute opacity-10" style="right: -10px; bottom: -10px; font-size: 5rem;">
                <i class="fa-solid fa-users"></i>
            </div>
            <div class="small text-muted mb-1 text-uppercase fw-bold letter-spacing-1">Team Members</div>
            <div class="d-flex align-items-center gap-3 mt-2">
                <div class="h1 fw-bold mb-0 text-success">{{ totalUsersCount }}</div>
                <div class="badge bg-success-subtle text-success rounded-pill px-3">Active</div>
            </div>
        </div>
    </div>
</div>

<!-- Recent Activity -->
<div class="row">
    <div class="col-12">
        <div class="glass-card border-0 shadow-sm overflow-hidden p-0">
            <div class="d-flex justify-content-between align-items-center p-4 border-bottom bg-white bg-opacity-25">
                <h5 class="fw-bold mb-0">
                    <i class="fa-solid fa-list-check text-primary me-2"></i>
                    {% if isAdmin %}Recent Team Activity{% else %}Your Recent Entries{% endif %}
                </h5>
                <a href="{{ path('app_time_entry_index') }}" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                    View All <i class="fa-solid fa-arrow-right small ms-1"></i>
                </a>
            </div>
            
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light bg-opacity-50">
                        <tr>
                            <th class="ps-4 border-0 text-muted small text-uppercase py-3">Date</th>
                            {% if isAdmin %}<th class="border-0 text-muted small text-uppercase py-3">User</th>{% endif %}
                            <th class="border-0 text-muted small text-uppercase py-3">Project</th>
                            <th class="border-0 text-muted small text-uppercase py-3">Duration</th>
                            <th class="border-0 text-muted small text-uppercase py-3">Notes</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for entry in recentEntries %}
                            <tr class="border-bottom-0">
                                <td class="ps-4 py-3">
                                    <div class="fw-bold">{{ entry.date|date('d M Y') }}</div>
                                    <div class="small text-muted d-md-none">{{ entry.project.name }}</div>
                                </td>
                                {% if isAdmin %}
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="avatar-sm bg-primary text-white rounded-circle d-flex align-items-center justify-content-center small" style="width: 24px; height: 24px; font-size: 10px;">
                                            {{ entry.user.name|slice(0, 1)|upper }}
                                        </div>
                                        <span class="small fw-medium">{{ entry.user.name }}</span>
                                    </div>
                                </td>
                                {% endif %}
                                <td>
                                    <span class="badge border fw-medium rounded-pill px-3 py-2" 
                                          style="border-color: {{ entry.project.color }}40 !important; color: {{ entry.project.color }}; background: {{ entry.project.color }}10;">
                                        <i class="fa-solid fa-circle small me-1 opacity-50" style="color: {{ entry.project.color }};"></i>
                                        {{ entry.project.name }}
                                    </span>
                                </td>
                                <td>
                                    <div class="fw-bold text-dark">{{ entry.hours }} <small class="text-muted fw-normal">h</small></div>
                                </td>
                                <td class="text-muted">
                                    <div class="text-truncate small" style="max-width: 250px;">
                                        {{ entry.note|default('No notes provided') }}
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="{% if isAdmin %}5{% else %}4{% endif %}" class="text-center py-5">
                                    <div class="my-3 opacity-25">
                                        <i class="fa-solid fa-clipboard-list h1"></i>
                                    </div>
                                    <p class="text-muted">No activities recorded yet.</p>
                                    <a href="{{ path('app_time_entry_new') }}" class="btn btn-primary-glass btn-sm">Start Tracking</a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .letter-spacing-1 { letter-spacing: 0.5px; }
    .avatar-sm { line-height: 1; }
    .table-hover tbody tr:hover {
        background-color: rgba(99, 102, 241, 0.03);
        cursor: default;
    }
</style>
{% endblock %}
