<!DOCTYPE html>
<html>
    {% set is_auth_page = app.request.attributes.get('_route') in ['app_login', 'app_register'] %}

    <head>
        <meta charset="UTF-8">
        <title>{% block title %}DivaTime - Professional Time tracking{% endblock %}</title>
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⏱️</text></svg>">
        
        <!-- Google Fonts -->
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&display=swap" rel="stylesheet">
        
        <!-- Bootstrap 5 & FontAwesome -->
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

        <style>
            :root {
                --sidebar-width: 280px;
                --primary-gradient: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
                --glass-bg: rgba(255, 255, 255, 0.7);
                --glass-border: rgba(255, 255, 255, 0.3);
            }

            body {
                font-family: 'Outfit', sans-serif;
                background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
                min-height: 100vh;
                color: #1e293b;
                overflow-x: hidden;
            }

            /* Glassmorphism Background Shapes */
            .bg-blob {
                position: fixed;
                width: 500px;
                height: 500px;
                background: var(--primary-gradient);
                filter: blur(80px);
                opacity: 0.15;
                z-index: -1;
                border-radius: 50%;
                animation: float 20s infinite alternate cubic-bezier(0.4, 0, 0.2, 1);
            }

            @keyframes float {
                0% { transform: translate(0, 0) scale(1); }
                33% { transform: translate(30px, -50px) scale(1.1); }
                66% { transform: translate(-20px, 20px) scale(0.9); }
                100% { transform: translate(0, 0) scale(1); }
            }

            .sidebar {
                width: var(--sidebar-width);
                height: 100vh;
                position: fixed;
                left: 0;
                top: 0;
                background: var(--glass-bg);
                backdrop-filter: blur(15px);
                border-right: 1px solid var(--glass-border);
                padding: 0 1.5rem 1.5rem 1.5rem;
                z-index: 1000;
                transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            }

            .main-content {
                padding: 2.5rem;
                min-height: 100vh;
                {% if not is_auth_page %}
                margin-left: var(--sidebar-width);
                {% endif %}
            }

            .nav-link {
                color: #64748b;
                padding: 0.8rem 1.2rem;
                border-radius: 12px;
                margin-bottom: 0.5rem;
                transition: all 0.2s;
                font-weight: 500;
                display: flex;
                align-items: center;
                gap: 12px;
            }

            .nav-link:hover {
                background: rgba(99, 102, 241, 0.1);
                color: #6366f1;
                transform: translateX(5px);
            }

            .nav-link.active {
                background: var(--primary-gradient);
                color: white !important;
                box-shadow: 0 10px 15px -3px rgba(139, 92, 246, 0.3);
            }

            .glass-card {
                background: var(--glass-bg);
                backdrop-filter: blur(10px);
                border: 1px solid var(--glass-border);
                border-radius: 20px;
                padding: 1.5rem;
                box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
            }

            .btn-primary-glass {
                background: var(--primary-gradient);
                border: none;
                color: white;
                padding: 0.6rem 1.5rem;
                border-radius: 12px;
                font-weight: 600;
                transition: all 0.3s;
            }

            .btn-primary-glass:hover {
                transform: translateY(-2px);
                box-shadow: 0 10px 15px -3px rgba(139, 92, 246, 0.4);
                color: white;
            }

            .badge-active { background: #dcfce7; color: #15803d; }
            .badge-inactive { background: #fee2e2; color: #b91c1c; }

            .top-header {
                display: flex;
                justify-content: flex-end;
                align-items: center;
                padding: 1rem 1.5rem;
                background: var(--glass-bg);
                backdrop-filter: blur(10px);
                border-bottom: 1px solid var(--glass-border);
                margin: -2.5rem -2.5rem 2.5rem -2.5rem;
                position: sticky;
                top: 0;
                z-index: 100;
            }

            .profile-card {
                background: rgba(255, 255, 255, 0.5);
                border: 1px solid var(--glass-border);
                border-radius: 15px;
                padding: 0.5rem 1rem;
                transition: all 0.3s;
            }

            .profile-card:hover {
                background: rgba(255, 255, 255, 0.8);
                transform: translateY(-2px);
            }

            @media (max-width: 991px) {
                .sidebar { transform: translateX(-100%); }
                .main-content { margin-left: 0 !important; }
                .sidebar.open { transform: translateX(0); }
            }
        </style>

        {% block stylesheets %}{% endblock %}
    </head>
    <body>
        <div class="bg-blob" style="top: -100px; right: -100px;"></div>
        <div class="bg-blob" style="bottom: -100px; left: -100px; background: linear-gradient(135deg, #3b82f6 0%, #2dd4bf 100%);"></div>

        {% if not is_auth_page %}
        <aside class="sidebar" id="sidebar">
            <div class="text-center py-4">
                <a href="{{ path('app_dashboard') }}" class="text-decoration-none">
                    <img src="{{ asset('img/logo.png') }}" alt="DivaTime" style="width: 180px; height: auto; filter: drop-shadow(0 5px 15px rgba(0,0,0,0.05));">
                </a>
            </div>


            <nav class="nav flex-column">
                <a href="{{ path('app_dashboard') }}" class="nav-link {{ app.request.get('_route') == 'app_dashboard' ? 'active' : '' }}">
                    <i class="fa-solid fa-chart-pie"></i> Dashboard
                </a>
                <a href="{{ path('app_time_entry_index') }}" class="nav-link {{ 'app_time_entry' in app.request.get('_route') ? 'active' : '' }}">
                    <i class="fa-solid fa-clock"></i> My Entries
                </a>
                
                {% if is_granted('ROLE_ADMIN') %}
                <div class="mt-4 mb-2 px-3 small text-uppercase text-muted fw-bold">Management</div>
                <a href="{{ path('app_project_index') }}" class="nav-link {{ 'app_project' in app.request.get('_route') ? 'active' : '' }}">
                    <i class="fa-solid fa-folder"></i> Projects
                </a>
                <a href="{{ path('app_user_index') }}" class="nav-link {{ 'app_user' in app.request.get('_route') ? 'active' : '' }}">
                    <i class="fa-solid fa-users"></i> Team
                </a>
                {% endif %}
            </nav>

        </aside>
        {% endif %}

        <main class="main-content">
            {% if not is_auth_page and app.user %}
            <header class="top-header">
                <div class="profile-card d-flex align-items-center gap-3">
                    <div class="text-end d-none d-sm-block">
                        <div class="fw-bold" style="font-size: 0.9rem; line-height: 1;">{{ app.user.name }}</div>
                        <a href="{{ path('app_logout') }}" class="text-danger text-decoration-none" style="font-size: 0.75rem;">Logout</a>
                    </div>
                    <div class="avatar bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 38px; height: 38px; font-weight: 600;">
                        {{ app.user.name|slice(0, 1)|upper }}
                    </div>
                </div>
            </header>
            {% endif %}
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ label }} glass-card mb-4 border-0 shadow-sm slide-in">
                        {{ message }}
                    </div>
                {% endfor %}
            {% endfor %}

            {% block body %}{% endblock %}
        </main>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
        {% block javascripts %}{% endblock %}
    </body>
</html>
