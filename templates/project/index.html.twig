{% extends 'base.html.twig' %}

{% block title %}Projets - DivaTime{% endblock %}

{% block body %}
<div class="mb-5 d-flex justify-content-between align-items-center">
    <div>
        <h2 class="fw-bold mb-1">Bibliothèque de Projets</h2>
        <p class="text-muted mb-0">Gérez et organisez les initiatives de votre équipe.</p>
    </div>
    <a href="{{ path('app_project_new') }}" class="btn btn-primary-glass">
        <i class="fa-solid fa-plus me-2"></i> Nouveau Projet
    </a>
</div>

<div class="row g-4">
    {% for project in projects %}
        <div class="col-12 col-md-6 col-xl-4">
            <div class="glass-card h-100 p-0 overflow-hidden shadow-sm">
                <div style="height: 6px; background-color: {{ project.color }}"></div>
                <div class="p-4">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <h5 class="fw-bold mb-0">{{ project.name }}</h5>
                        {% if project.isActive %}
                            <span class="badge badge-active rounded-pill px-3 py-1 small">Actif</span>
                        {% else %}
                            <span class="badge badge-inactive rounded-pill px-3 py-1 small">Inactif</span>
                        {% endif %}
                    </div>
                    
                    <p class="text-muted small mb-4" style="height: 48px; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;">
                        {{ project.description|default('Aucune description fournie.') }}
                    </p>
                    
                    <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                        <div class="small text-muted">Créé : {{ project.createdAt|date('M Y') }}</div>
                        <div class="d-flex gap-2">
                            <a href="{{ path('app_project_edit', {'id': project.id}) }}" class="btn btn-sm btn-outline-secondary rounded-3">
                                <i class="fa-solid fa-edit"></i>
                            </a>
                            <form method="post" action="{{ path('app_project_delete', {'id': project.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce projet ?');" style="display:inline-block">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ project.id) }}">
                                <button class="btn btn-sm btn-outline-danger rounded-3">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {% else %}
        <div class="col-12">
            <div class="glass-card text-center py-5">
                <i class="fa-solid fa-folder-open h1 opacity-25 d-block mb-3"></i>
                <p class="text-muted mb-0">Aucun projet trouvé. Commencez par en créer un !</p>
            </div>
        </div>
    {% endfor %}
</div>
{% endblock %}
