{% extends 'base.html.twig' %}

{% block title %}DivaTime - Create Account{% endblock %}

{% block body %}
<div class="row justify-content-center align-items-center min-vh-100 m-0">
    <div class="col-12 col-md-6 col-lg-5" style="margin-top: -50px;">
        <!-- Logo Section -->
        <div class="text-center mb-n5" style="z-index: 20; position: relative; pointer-events: none;">
            <div class="d-inline-block">
                <img src="{{ asset('img/logo.png') }}" alt="DivaTime Logo" style="max-height: 120px; width: auto; object-fit: contain; filter: drop-shadow(0 10px 20px rgba(0,0,0,0.1));">
            </div>
        </div>

        <!-- Register Card -->
        <div class="glass-card p-5 pt-4 border-0 shadow-lg" style="position: relative; z-index: 5;">
            <h2 class="text-center mb-4 fw-bold text-gradient">Join DivaTime</h2>

            {% for flash_error in app.flashes('verify_email_error') %}
                <div class="alert alert-danger bg-danger-subtle border-0 text-danger rounded-3 mb-4">
                    <i class="fa-solid fa-circle-exclamation me-2"></i> {{ flash_error }}
                </div>
            {% endfor %}

            {{ form_errors(registrationForm) }}

            {{ form_start(registrationForm) }}
                <div class="mb-4">
                    {{ form_label(registrationForm.name, 'Full Name', {'label_attr': {'class': 'form-label text-muted fw-semibold'}}) }}
                    <div class="input-group">
                        <span class="input-group-text bg-transparent border-0 border-bottom border-muted rounded-0 px-0 me-3">
                            <i class="fa-solid fa-user text-muted opacity-50"></i>
                        </span>
                        {{ form_widget(registrationForm.name, {
                            'attr': {
                                'class': 'form-control bg-transparent border-0 border-bottom rounded-0 px-0 focus-none',
                                'placeholder': 'John Doe'
                            }
                        }) }}
                    </div>
                </div>

                <div class="mb-4">
                    {{ form_label(registrationForm.email, 'Email Address', {'label_attr': {'class': 'form-label text-muted fw-semibold'}}) }}
                    <div class="input-group">
                        <span class="input-group-text bg-transparent border-0 border-bottom border-muted rounded-0 px-0 me-3">
                            <i class="fa-solid fa-envelope text-muted opacity-50"></i>
                        </span>
                        {{ form_widget(registrationForm.email, {
                            'attr': {
                                'class': 'form-control bg-transparent border-0 border-bottom rounded-0 px-0 focus-none',
                                'placeholder': 'john@example.com'
                            }
                        }) }}
                    </div>
                </div>

                <div class="mb-4">
                    {{ form_label(registrationForm.plainPassword, 'Password', {'label_attr': {'class': 'form-label text-muted fw-semibold'}}) }}
                    <div class="input-group">
                        <span class="input-group-text bg-transparent border-0 border-bottom border-muted rounded-0 px-0 me-3">
                            <i class="fa-solid fa-lock text-muted opacity-50"></i>
                        </span>
                        {{ form_widget(registrationForm.plainPassword, {
                            'attr': {
                                'class': 'form-control bg-transparent border-0 border-bottom rounded-0 px-0 focus-none',
                                'placeholder': '••••••••'
                            }
                        }) }}
                    </div>
                </div>

                <div class="mb-5">
                    <div class="form-check custom-check">
                        {{ form_widget(registrationForm.agreeTerms, {'attr': {'class': 'form-check-input'}}) }}
                        {{ form_label(registrationForm.agreeTerms, 'I agree to the terms and conditions', {'label_attr': {'class': 'form-check-label small text-muted'}}) }}
                    </div>
                </div>

                <button class="btn btn-primary-glass w-100 py-3 shadow-sm" type="submit">
                    <i class="fa-solid fa-user-plus me-2"></i> Create My Account
                </button>

            {{ form_end(registrationForm) }}
        </div>

        <div class="text-center mt-5">
            <p class="text-muted small">&copy; {{ "now"|date("Y") }} DivaTime Inc. All rights reserved.</p>
        </div>
    </div>
</div>

<style>
    .text-gradient {
        background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }
    .focus-none:focus {
        box-shadow: none !important;
        background: transparent !important;
        border-color: #6366f1 !important;
    }
    .hover-primary:hover {
        color: #6366f1 !important;
    }
    .custom-check .form-check-input:checked {
        background-color: #6366f1;
        border-color: #6366f1;
    }
</style>
{% endblock %}
