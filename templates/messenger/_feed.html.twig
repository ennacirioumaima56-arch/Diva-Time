<turbo-frame id="messages" class="message-feed flex-grow-1 overflow-y-auto px-2" 
             data-controller="messenger-scroll">
    {% for message in messages %}
        <div class="glass-card mb-4 slide-in">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="avatar bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 45px; height: 45px; font-weight: 600; font-size: 1.1rem;">
                        {{ message.sender.name|slice(0, 1)|upper }}
                    </div>
                    <div>
                        <h6 class="fw-bold mb-0">{{ message.sender.name }}</h6>
                        <span class="text-muted small">
                            <i class="fa-regular fa-clock me-1"></i> {{ message.createdAt|date('M d, H:i') }}
                        </span>
                    </div>
                </div>
            </div>
            <div class="message-content ps-1">
                <p class="mb-0 text-secondary" style="font-size: 1.05rem; line-height: 1.6;">
                    {{ message.content|nl2br }}
                </p>
            </div>
        </div>
    {% else %}
        <div class="glass-card text-center py-5">
            <div class="mb-3">
                <i class="fa-solid fa-comments text-muted opacity-25" style="font-size: 4rem;"></i>
            </div>
            <h5 class="text-muted">Aucun message. Soyez le premier à partager !</h5>
        </div>
    {% endfor %}
</turbo-frame>
