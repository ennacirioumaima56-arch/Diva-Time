{% extends 'base.html.twig' %}

{% block title %}Team Management - DivaTime{% endblock %}

{% block body %}
<div class="mb-5 d-flex justify-content-between align-items-center">
    <div>
        <h2 class="fw-bold mb-1">Team Directory</h2>
        <p class="text-muted mb-0">Manage your workforce, roles, and access privileges.</p>
    </div>
    <a href="{{ path('app_user_new') }}" class="btn btn-primary-glass">
        <i class="fa-solid fa-user-plus me-2"></i> Add Member
    </a>
</div>

<div class="glass-card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr class="text-muted small">
                    <th class="border-0">Member</th>
                    <th class="border-0">Email</th>
                    <th class="border-0">Role</th>
                    <th class="border-0">Verified</th>
                    <th class="border-0 text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for user in users %}
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-3">
                                <div class="avatar bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 38px; height: 38px;">
                                    {{ user.name|slice(0, 1)|upper }}
                                </div>
                                <div class="fw-semibold">{{ user.name }}</div>
                            </div>
                        </td>
                        <td class="text-muted">{{ user.email }}</td>
                        <td>
                            {% for role in user.roles %}
                                {% if role == 'ROLE_ADMIN' %}
                                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-3 py-2 rounded-pill small">Admin</span>
                                {% elseif role == 'ROLE_USER' %}
                                    <span class="badge bg-info-subtle text-info border border-info-subtle px-3 py-2 rounded-pill small">Member</span>
                                {% endif %}
                            {% endfor %}
                        </td>
                        <td>
                            {% if user.isVerified %}
                                <span class="badge badge-active px-3 py-1 rounded-pill"><i class="fa-solid fa-check me-1"></i> Yes</span>
                            {% else %}
                                <span class="badge badge-inactive px-3 py-1 rounded-pill"><i class="fa-solid fa-xmark me-1"></i> No</span>
                            {% endif %}
                        </td>
                        <td class="text-end">
                            <div class="dropdown">
                                <button class="btn btn-light btn-sm rounded-circle shadow-sm" type="button" data-bs-toggle="dropdown">
                                    <i class="fa-solid fa-ellipsis-vertical px-1"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end glass-card p-2 border-0 shadow-lg">
                                    <li><a class="dropdown-item rounded-2" href="{{ path('app_user_edit', {'id': user.id}) }}"><i class="fa-solid fa-edit me-2"></i> Edit</a></li>
                                    <li><hr class="dropdown-divider opacity-50"></li>
                                    <li>
                                        <form method="post" action="{{ path('app_user_delete', {'id': user.id}) }}" onsubmit="return confirm('Are you sure you want to delete this member?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
                                            <button class="dropdown-item text-danger rounded-2"><i class="fa-solid fa-trash me-2"></i> Delete</button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5" class="text-center py-5">No members found.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
