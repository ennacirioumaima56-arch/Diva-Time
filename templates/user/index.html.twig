{% extends 'base.html.twig' %}

{% block title %}Gestion de l'Équipe - DivaTime{% endblock %}

{% block body %}
<div class="mb-5 d-flex justify-content-between align-items-center">
    <div>
        <h2 class="fw-bold mb-1">Annuaire de l'Équipe</h2>
        <p class="text-muted mb-0">Gérez vos effectifs, rôles et privilèges d'accès.</p>
    </div>
    <a href="{{ path('app_user_new') }}" class="btn btn-primary-glass">
        <i class="fa-solid fa-user-plus me-2"></i> Ajouter un Membre
    </a>
</div>

<div class="glass-card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr class="text-muted small">
                    <th class="border-0">Membre</th>
                    <th class="border-0">Email</th>
                    <th class="border-0">Rôle</th>
                    <th class="border-0">Vérifié</th>
                    <th class="border-0 text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for user in users %}
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-3">
                                <div class="avatar bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 38px; height: 38px;">
                                    {{ user.name|slice(0, 1)|upper }}
                                </div>
                                <div class="fw-semibold">{{ user.name }}</div>
                            </div>
                        </td>
                        <td class="text-muted">{{ user.email }}</td>
                        <td>
                            {% for role in user.roles %}
                                {% if role == 'ROLE_ADMIN' %}
                                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-3 py-2 rounded-pill small">Admin</span>
                                {% elseif role == 'ROLE_USER' %}
                                    <span class="badge bg-info-subtle text-info border border-info-subtle px-3 py-2 rounded-pill small">Membre</span>
                                {% endif %}
                            {% endfor %}
                        </td>
                        <td>
                            {% if user.isVerified %}
                                <span class="badge badge-active px-3 py-1 rounded-pill"><i class="fa-solid fa-check me-1"></i> Oui</span>
                            {% else %}
                                <span class="badge badge-inactive px-3 py-1 rounded-pill"><i class="fa-solid fa-xmark me-1"></i> Non</span>
                            {% endif %}
                        </td>
                        <td class="text-end">
                            <div class="d-flex justify-content-end gap-2">
                                <a href="{{ path('app_user_edit', {'id': user.id}) }}" class="btn btn-sm btn-outline-primary rounded-pill px-3 shadow-sm" title="Éditer">
                                    <i class="fa-solid fa-pen-to-square"></i>
                                </a>
                                <form method="post" action="{{ path('app_user_delete', {'id': user.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce membre ?');" class="d-inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
                                    <button class="btn btn-sm btn-outline-danger rounded-pill px-3 shadow-sm" title="Supprimer">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5" class="text-center py-5">Aucun membre trouvé.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
