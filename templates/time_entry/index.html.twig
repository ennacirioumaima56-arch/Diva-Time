{% extends 'base.html.twig' %}

{% block title %}Time Log - DivaTime{% endblock %}

{% block body %}
<div class="mb-5 d-flex justify-content-between align-items-center">
    <div>
        <h2 class="fw-bold mb-1">Activity Log</h2>
        <p class="text-muted mb-0">Review and manage your daily contributions.</p>
    </div>
    <a href="{{ path('app_time_entry_new') }}" class="btn btn-primary-glass">
        <i class="fa-solid fa-clock-rotate-left me-2"></i> Log New Session
    </a>
</div>

<div class="glass-card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr class="text-muted small">
                    <th class="border-0">Date</th>
                    <th class="border-0">Project</th>
                    <th class="border-0">Hours</th>
                    <th class="border-0">Description</th>
                    <th class="border-0 text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for entry in time_entries %}
                    <tr>
                        <td class="fw-bold text-primary">{{ entry.date|date('D, M d, Y') }}</td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div style="width: 10px; height: 10px; background-color: {{ entry.project.color }}; border-radius: 50%;"></div>
                                <span>{{ entry.project.name }}</span>
                            </div>
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border border-secondary-subtle px-3 py-2 rounded-pill">
                                {{ entry.hours }}h
                            </span>
                        </td>
                        <td>
                            <span class="text-muted small d-inline-block text-truncate" style="max-width: 300px;">
                                {{ entry.note|default('No description.') }}
                            </span>
                        </td>
                        <td class="text-end">
                            <div class="d-flex gap-2 justify-content-end">
                                <a href="{{ path('app_time_entry_edit', {'id': entry.id}) }}" class="btn btn-sm btn-light border-0 rounded-circle shadow-sm" title="Edit">
                                    <i class="fa-solid fa-edit p-1"></i>
                                </a>
                                <form method="post" action="{{ path('app_time_entry_delete', {'id': entry.id}) }}" onsubmit="return confirm('Are you sure you want to delete this entry?');" style="display:inline-block">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ entry.id) }}">
                                    <button class="btn btn-sm btn-light text-danger border-0 rounded-circle shadow-sm" title="Delete">
                                        <i class="fa-solid fa-trash p-1"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5" class="text-center py-5">
                            <i class="fa-solid fa-clock h1 opacity-25 d-block mb-3"></i>
                            <p class="text-muted mb-0">No time entries recorded yet.</p>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
