{% extends 'base.html.twig' %}

{% block title %}Log Time - TimeTrack{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="mb-4 d-flex align-items-center gap-3">
            <a href="{{ path('app_time_entry_index') }}" class="btn btn-light rounded-circle shadow-sm" style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;">
                <i class="fa-solid fa-arrow-left"></i>
            </a>
            <h2 class="fw-bold mb-0">Log Work Hours</h2>
        </div>

        <div class="glass-card p-5">
            {{ include('time_entry/_form.html.twig', {'button_label': 'Save Entry'}) }}
        </div>
    </div>
</div>
{% endblock %}
