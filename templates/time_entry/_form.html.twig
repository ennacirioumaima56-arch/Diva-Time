{{ form_start(form) }}
    <div class="row g-4">
        <div class="col-md-6">
            <label class="form-label fw-semibold text-muted mb-2">Date</label>
            {{ form_widget(form.date, {'attr': {'class': 'form-control glass-input py-2 px-3'}}) }}
            <div class="text-danger small mt-1">{{ form_errors(form.date) }}</div>
        </div>
        <div class="col-md-6">
            <label class="form-label fw-semibold text-muted mb-2">Heures Travaillées</label>
            {{ form_widget(form.hours, {'attr': {'class': 'form-control glass-input py-2 px-3'}}) }}
            <div class="text-danger small mt-1">{{ form_errors(form.hours) }}</div>
        </div>
        <div class="col-12">
            <label class="form-label fw-semibold text-muted mb-2">Projet</label>
            {{ form_widget(form.project, {'attr': {'class': 'form-select glass-input py-2 px-3'}}) }}
            <div class="text-danger small mt-1">{{ form_errors(form.project) }}</div>
        </div>
        <div class="col-12">
            <label class="form-label fw-semibold text-muted mb-2">Note / Description</label>
            {{ form_widget(form.note, {'attr': {'class': 'form-control glass-input py-2 px-3', 'rows': 3}}) }}
            <div class="text-danger small mt-1">{{ form_errors(form.note) }}</div>
        </div>
    </div>
    
    <div class="mt-5 d-flex gap-3 justify-content-end">
        <a href="{{ path('app_time_entry_index') }}" class="btn btn-light px-4 py-2 border-0 rounded-3 text-muted">Annuler</a>
        <button type="submit" class="btn btn-primary-glass px-5 py-2">
            <i class="fa-solid fa-save me-2"></i> {{ button_label|default('Enregistrer') }}
        </button>
    </div>
{{ form_end(form) }}

<style>
    .glass-input {
        background: rgba(255, 255, 255, 0.5) !important;
        border: 1px solid rgba(255, 255, 255, 0.4) !important;
        backdrop-filter: blur(5px);
        transition: all 0.3s;
    }
    .glass-input:focus {
        background: rgba(255, 255, 255, 0.8) !important;
        border-color: #6366f1 !important;
        box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.1) !important;
    }
</style>
